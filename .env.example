# =========================================================
# HOSTEL HUB - ENVIRONMENT CONFIGURATION
# =========================================================

# Application
APP_ENV=production
APP_SECRET_KEY=hostelhub-super-secret-key-change-in-production
PORT=8501

# Database Configuration (SQLite by default; supports PostgreSQL / MySQL RDS on AWS)
# For RDS PostgreSQL: postgresql://username:password@rds-endpoint.amazonaws.com:5432/hostelhub
DATABASE_URL=sqlite:///hostel_hub.db

# AWS Configuration
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=hostelhub-media-474333173964
AWS_S3_SYNC_ENABLED=true
